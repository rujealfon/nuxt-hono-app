# Shared
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=3001
API_HOST=0.0.0.0
API_URL=http://localhost:3001
# Shared parent for same-site sibling hosts. Omit on *.vercel.app previews.
COOKIE_DOMAIN=localhost

# Database (Postgres)
POSTGRES_USER=nuxt_app_postgres_user
POSTGRES_PASSWORD=nuxt_app_postgres_password
POSTGRES_DB=nuxt_app_db
# Host apps against Compose Postgres (published 5433). Native Postgres: use 5432.
DATABASE_URL=postgres://nuxt_app_postgres_user:nuxt_app_postgres_password@localhost:5433/nuxt_app_db
# Optional. Defaults to the same host/user as DATABASE_URL with database nuxt_app_db_test
DATABASE_URL_TEST=postgres://nuxt_app_postgres_user:nuxt_app_postgres_password@localhost:5433/nuxt_app_db_test
# Direct (non-pooled) connection string, used only for migrations.
# Required in production when DATABASE_URL is a pooled (PgBouncer) endpoint, e.g. Neon.
# Neon uses sslmode=verify-full:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=verify-full
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Redis (TCP). Host apps + Compose Redis: redis://localhost:6380.
# Upstash (Vercel): use rediss:// (TLS), not redis://. Upstash endpoints enforce TLS ("TLS/SSL: Enabled").
# REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
REDIS_URL=redis://localhost:6380
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
# Set only when a reverse proxy overwrites X-Forwarded-For (e.g. Vercel).
# TRUST_PROXY=true

# Frontends (for CORS + redirects)
# APP_URL, ADMIN_URL, WEB_URL, and REDIS_URL are required when NODE_ENV=production
# (the API exits on boot if any is missing outside Vercel, which supplies preview
# fallbacks for these three via resolveVercelPreviewUrl()).
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
WEB_URL=http://localhost:3003
NUXT_PUBLIC_API_URL=http://localhost:3001
# Preview only, on app + admin. Value = nuxt-app-api Protection Bypass secret.
# NUXT_API_PROTECTION_BYPASS=
# Baked into the static marketing site at generate time
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Seed (`pnpm db:seed`). ADMIN_PASSWORD is required to create the admin user.
# ADMIN_EMAIL=admin@nuxt-app.com
# ADMIN_NAME=Admin
# ADMIN_PASSWORD=
