# syntax=docker/dockerfile:1
FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate
RUN npm install --global turbo@2.10.10
WORKDIR /repo

# `turbo prune` computes the workspace-dependency subgraph for this app from
# turbo.json + the lockfile, so new packages/layers don't need a Dockerfile edit.
FROM base AS pruner
ARG PACKAGE
COPY . .
RUN turbo prune ${PACKAGE} --docker

FROM base AS development
COPY --from=pruner /repo/out/json/ .
COPY --from=pruner /repo/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile
COPY --from=pruner /repo/out/full/ .

FROM development AS build
ARG PACKAGE
RUN pnpm --filter ${PACKAGE} build

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NITRO_HOST=0.0.0.0
ARG APP_DIR
COPY --from=build /repo/${APP_DIR}/.output ./.output
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
