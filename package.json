{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@nuxt-app/api",
    "dev:app": "turbo run dev --filter=@nuxt-app/app",
    "dev:admin": "turbo run dev --filter=@nuxt-app/admin",
    "dev:web": "turbo run dev --filter=@nuxt-app/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @nuxt-app/api db:generate",
    "db:check": "pnpm --filter @nuxt-app/api db:check",
    "db:migrate": "pnpm --filter @nuxt-app/api db:migrate",
    "db:studio": "pnpm --filter @nuxt-app/api db:studio",
    "db:seed": "pnpm --filter @nuxt-app/api db:seed",
    "predocker:up": "bash scripts/ensure-docker-env.sh",
    "predocker:rebuild": "bash scripts/ensure-docker-env.sh",
    "predocker:reset": "bash scripts/ensure-docker-env.sh",
    "docker:up": "docker compose up -d --wait --remove-orphans",
    "docker:down": "docker compose down",
    "docker:start": "docker compose start",
    "docker:stop": "docker compose stop",
    "docker:restart": "docker compose restart",
    "docker:rebuild": "docker compose pull postgres redis && docker compose up --build -d --wait --remove-orphans",
    "docker:reset": "docker compose down -v && docker compose up --build -d --wait --remove-orphans",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier-plugin-css-order": "^2.2.0",
    "turbo": "^2.10.10",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*": "eslint --fix --no-warn-ignored"
  }
}
